LANTERN_ENV=local

# Local Compose/test owner only; startup rejects this elevated credential.
# Provision roles per README.md and replace DATABASE_URL
# in your private .env with the runtime URL. Keep other credentials out of .env.
DATABASE_URL=postgresql://career_lead:career_lead_local@127.0.0.1:55439/career_lead
POSTGRES_USER=career_lead
POSTGRES_PASSWORD=career_lead_local
POSTGRES_DB=career_lead
POSTGRES_PORT=55439
HOST=127.0.0.1
PORT=4391

# Public canonical origin: HTTPS when hosted; no trailing slash.
APP_ORIGIN=http://127.0.0.1:4391
# Configure a Google Web OAuth client with APP_ORIGIN/auth/google/callback.
# Leave blank until real credentials are supplied outside Git.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional single-user local walkthrough (loopback only; rejected in NODE_ENV=production).
LOCAL_ACCESS=0

# Optional inference: both dedicated provider keys are required when enabled.
# Store actual keys only in private local config / Railway web-service variables.
COACH_ENABLED=0
AI_GATEWAY_CHAT_BASE_URL=https://ai-gateway.jesusfilm.org
AI_GATEWAY_CHAT_MODEL=coding
COACH_FALLBACK_MODEL=google/gemini-3.8-flash
