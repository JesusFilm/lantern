LANTERN_ENV=local

# Local Compose/test owner only; startup rejects this elevated credential.
# Provision roles per README.md and replace DATABASE_URL
# in your private .env with the runtime URL. Keep other credentials out of .env.
DATABASE_URL=postgresql://career_lead:career_lead_local@127.0.0.1:55439/career_lead
POSTGRES_USER=career_lead
POSTGRES_PASSWORD=career_lead_local
POSTGRES_DB=career_lead
POSTGRES_PORT=55439
HOST=127.0.0.1
PORT=4391

# Public canonical origin: HTTPS when hosted; no trailing slash.
APP_ORIGIN=http://127.0.0.1:4391
# Public PKCE client registered in Forge Auth with APP_ORIGIN/auth/jesusfilm/callback.
# Registration must be deployed before real sign-in works. No client secret.
AUTH_CLIENT_ID=jfp_lantern_local

# Optional single-user local walkthrough (loopback only; rejected in NODE_ENV=production).
LOCAL_ACCESS=0

# Optional inference: the goal coach works once both provider keys and an explicit gateway URL are set.
# Whether members are offered it is the coach feature below (shown locally unless set to off).
# Store actual keys only in private local config / Railway web-service variables.
# Replace this illustrative URL with the reachable gateway origin.
AI_GATEWAY_CHAT_BASE_URL=https://gateway.example.com
AI_GATEWAY_CHAT_MODEL=coding
COACH_FALLBACK_MODEL=google/gemini-3.8-flash

# Optional flagged-feature states (name=off|preview|on, comma-separated) and the
# accounts that see previews. Locally, unset features are shown.
# See docs/development/feature-flags.md.
LANTERN_FEATURES=
LANTERN_PREVIEW_EMAILS=
