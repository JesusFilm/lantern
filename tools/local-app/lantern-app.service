[Unit]
Description=Lantern local application walkthrough
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/lantern
Environment=HOST=127.0.0.1
Environment=PORT=4391
Environment=APP_ORIGIN=http://127.0.0.1:4391
Environment=LOCAL_ACCESS=1
Environment=NODE_ENV=development
EnvironmentFile=-%h/.config/lantern/local-app.env
ExecStart=/usr/bin/env node --env-file=.env dist/server/index.js --production
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
