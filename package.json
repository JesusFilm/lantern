{
  "name": "lantern",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env server/index.ts",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node --env-file=.env dist/server/index.js --production",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.check.json",
    "test": "node --env-file=.env --import tsx --test server/health.integration.test.ts tools/ticket-board/tickets.test.ts",
    "db:start": "docker compose up -d --wait database",
    "db:stop": "docker compose stop database",
    "tickets": "tsx watch tools/ticket-board/index.ts",
    "tickets:test": "node --import tsx --test tools/ticket-board/tickets.test.ts",
    "predev": "npm run db:start",
    "prototype:layouts": "python3 -m http.server 4395 --bind 127.0.0.1 --directory prototype/site"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
