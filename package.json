{
  "name": "lantern",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env server/index.ts",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/index.js --production",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.check.json",
    "test": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 server/*.test.ts tools/ticket-board/tickets.test.ts tools/release/*.test.mjs",
    "db:start": "docker compose up -d --wait database",
    "db:stop": "docker compose stop database",
    "tickets": "tsx watch tools/ticket-board/index.ts",
    "tickets:test": "node --import tsx --test tools/ticket-board/tickets.test.ts",
    "predev": "npm run db:start",
    "access:ops": "tsx --env-file=.env.admin server/operations.ts",
    "preview:build": "vite build --config tools/guide-preview/vite.config.ts",
    "preview:dev": "vite --config tools/guide-preview/vite.config.ts --host 127.0.0.1",
    "dev:local": "LOCAL_ACCESS=1 tsx watch --env-file=.env server/index.ts",
    "predev:local": "npm run db:start",
    "start:local": "node --env-file-if-exists=.env dist/server/index.js --production",
    "db:migrate": "node dist/server/migrate.js",
    "access:ops:compiled": "node dist/server/operations.js",
    "db:bootstrap": "node dist/server/bootstrap-database.js",
    "db:migrate:local": "node --env-file=.env.migration dist/server/migrate.js",
    "test:local": "node --env-file=.env.example --import tsx --test --test-concurrency=1 server/*.test.ts tools/ticket-board/tickets.test.ts tools/release/*.test.mjs",
    "db:transition": "node dist/server/transition-database.js",
    "db:verify": "node dist/server/verify-database.js",
    "db:rehearse:local": "node --env-file=.env.example --import tsx tools/database/rehearse-recovery.ts"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "express": "^5.3.0",
    "google-auth-library": "^11.0.0",
    "lucide-react": "^1.59.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
